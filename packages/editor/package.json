{
  "name": "@advui/editor",
  "version": "0.14.0",
  "description": "Text editing for Adv UI: a WYSIWYG rich text editor (TipTap) that saves HTML, a Markdown editor with a toolbar and a preview, and viewers for both, on web, iOS and Android.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinmin232/advui.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/zinmin232/advui/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/zinmin232/advui/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./meta": "./src/meta/components.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/examples"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./meta": {
        "types": "./dist/meta/components.d.ts",
        "default": "./dist/meta/components.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:native": "jest --config jest.native.config.js"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@advui/icons": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0"
  },
  "peerDependencies": {
    "@advui/core": "workspace:^",
    "react": ">=19",
    "react-native": "*",
    "tamagui": "^3.1.3",
    "react-native-webview": ">=13.7"
  },
  "peerDependenciesMeta": {
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@advui/core": "workspace:*",
    "@advui/eslint-config": "workspace:*",
    "@advui/theme": "workspace:*",
    "@advui/tsconfig": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-preset-expo": "~57.0.13",
    "expo": "~57.0.25",
    "happy-dom": "^20.14.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "tamagui": "3.1.3",
    "test-renderer": "~1.2.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
