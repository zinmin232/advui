{
  "name": "@advui/theme",
  "version": "0.9.0",
  "description": "Design tokens, color presets and the Tamagui config factory for Adv UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinmin232/advui.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/zinmin232/advui/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/zinmin232/advui/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./material": "./src/material.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./material": {
        "types": "./dist/material.d.ts",
        "default": "./dist/material.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@advui/utils": "workspace:*",
    "@material/material-color-utilities": "0.3.0",
    "@tamagui/animations-css": "2.7.7",
    "@tamagui/animations-react-native": "2.7.7",
    "@tamagui/colors": "2.7.7",
    "@tamagui/web": "2.7.7"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@advui/eslint-config": "workspace:*",
    "@advui/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "tamagui": "2.7.7",
    "vitest": "^5.0.2"
  }
}
