{
  "name": "@advui/icons",
  "version": "0.3.0",
  "description": "Swappable icon abstraction for Adv UI with a tree-shakable default set (Lucide paths).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinmin232/advui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/zinmin232/advui/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/zinmin232/advui/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "LICENSE-lucide"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "generate": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*",
    "react-native-svg": ">=15",
    "tamagui": "^2.7.7"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@advui/eslint-config": "workspace:*",
    "@advui/theme": "workspace:*",
    "@advui/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "lucide": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "tamagui": "2.7.7",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@tamagui/core": "2.7.7",
    "@tamagui/web": "2.7.7"
  }
}
