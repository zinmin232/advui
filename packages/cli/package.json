{
  "name": "advui",
  "version": "0.1.0",
  "description": "CLI to add Adv UI components to your project (shadcn-style source installation).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinmin232/advui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/zinmin232/advui/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/zinmin232/advui/issues"
  },
  "type": "module",
  "bin": {
    "advui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@advui/eslint-config": "workspace:*",
    "@advui/tsconfig": "workspace:*",
    "vitest": "^5.0.2"
  }
}
