{
  "name": "@advui/core",
  "version": "0.11.0",
  "description": "Cross-platform React / React Native components built on Tamagui: buttons, forms, overlays, navigation, feedback, layout and media. Data, chart and editor components ship in @advui/data, @advui/charts and @advui/editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinmin232/advui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/zinmin232/advui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/zinmin232/advui/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./meta": "./src/meta/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/examples",
    "!src/**/*.meta.ts",
    "!src/meta"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:native": "jest --config jest.native.config.js"
  },
  "dependencies": {
    "@tamagui/core": "2.7.7",
    "@tamagui/dismissable": "2.7.7",
    "@tamagui/floating": "2.7.7",
    "@tamagui/focus-scope": "2.7.7",
    "@tamagui/roving-focus": "2.7.7",
    "@tamagui/toast": "2.7.7",
    "@tamagui/web": "2.7.7",
    "@advui/icons": "workspace:*",
    "@advui/theme": "workspace:*",
    "@advui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*",
    "react-native-svg": ">=15",
    "tamagui": "^2.7.7"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@advui/eslint-config": "workspace:*",
    "@advui/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-preset-expo": "~57.0.13",
    "expo": "~57.0.25",
    "happy-dom": "^20.14.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "tamagui": "2.7.7",
    "test-renderer": "~1.2.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
